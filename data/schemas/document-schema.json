{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consultoría Martínez Knowledge Document",
  "type": "object",
  "required": [
    "id",
    "title",
    "content_type",
    "source",
    "status",
    "topics",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "content_type": {
      "enum": [
        "normativa",
        "analisis_profesional",
        "guia_educativa",
        "faq"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "official",
            "consultoria_martinez",
            "educational",
            "other"
          ]
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "legal": {
      "type": "object",
      "properties": {
        "publication_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "vigente",
            "modificado",
            "sustituido",
            "derogado",
            "historico",
            "pending_review"
          ]
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "modifies",
                  "repeals",
                  "replaced_by",
                  "related_to"
                ]
              },
              "document_id": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "document_id"
            ]
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "archived",
        "blocked"
      ]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "required": [
        "last_checked",
        "review_status"
      ],
      "properties": {
        "last_checked": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_status": {
          "enum": [
            "unverified",
            "pending",
            "verified",
            "expired"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "access": {
      "type": "object",
      "properties": {
        "classification": {
          "enum": [
            "public",
            "internal",
            "private",
            "restricted"
          ]
        },
        "assistant_eligible": {
          "type": "boolean"
        }
      }
    }
  }
}